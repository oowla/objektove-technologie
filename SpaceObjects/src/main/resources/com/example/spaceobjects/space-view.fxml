<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.Pane?>
<Pane fx:id="root" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.spaceobjects.HelloController">
    <children>
        <Button layoutX="14.0" layoutY="24.0" onAction="#planet" text="Planet"/>
        <Button layoutX="80.0" layoutY="24.0" onAction="#asteroid" text="Asteroid"/>
        <Button layoutX="160.0" layoutY="24.0" onAction="#satellite" text="Satellite"/>
        <Button layoutX="240.0" layoutY="24.0" onAction="#change_color" text="Change color"/>
        <Button layoutX="350.0" layoutY="24.0" onAction="#move" text="Move"/>
    </children>
</Pane>
